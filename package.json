{
  "name": "agent-dora",
  "version": "0.3.0",
  "description": "Delivery metrics for teams shipping with AI coding agents: durable throughput, line churn, change failure rate and lead time, split by agent, AI-assisted and human authorship (Claude Code, Copilot, Codex, Cursor, Devin). CLI and GitHub Action.",
  "type": "module",
  "license": "MIT",
  "author": "Lonny Angell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langell/agent-dora.git"
  },
  "homepage": "https://github.com/langell/agent-dora#readme",
  "bugs": {
    "url": "https://github.com/langell/agent-dora/issues"
  },
  "bin": {
    "agent-dora": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test --test-timeout=60000 \"dist/test/*.test.js\"",
    "prepack": "tsc"
  },
  "keywords": [
    "dora",
    "dora-metrics",
    "metrics",
    "engineering-metrics",
    "engineering-analytics",
    "developer-productivity",
    "software-delivery",
    "devops",
    "ai",
    "ai-agents",
    "coding-agents",
    "ai-coding",
    "ai-code-quality",
    "claude",
    "claude-code",
    "copilot",
    "github-copilot",
    "codex",
    "cursor",
    "devin",
    "agents",
    "code-churn",
    "code-quality",
    "git-blame",
    "change-failure-rate",
    "lead-time",
    "pull-requests",
    "code-review",
    "github-action",
    "github-actions",
    "cli",
    "dashboard"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
